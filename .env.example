# Copie para .env.local (local) ou configure na Vercel (deploy)
NEXT_PUBLIC_SUPABASE_URL=https://olzgxpzhtipugyovivwv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domínio raiz dos catálogos (subdomínios: {slug}.catalogo.vercel.app)
NEXT_PUBLIC_ROOT_DOMAIN=catalogo.vercel.app

# E-mail do super admin (primeiro login vira super_admin automaticamente)
SUPER_ADMIN_EMAIL=seu@email.com

# Apenas servidor — NUNCA expor no cliente. Vercel: Production + Preview.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Apenas local — não commitar. Usado para migrations/SQL via script.
DATABASE_URL=postgresql://postgres:[SENHA]@db.olzgxpzhtipugyovivwv.supabase.co:5432/postgres
